[Unit]
Description=Push home lab + BMS status to reydelgutierrez.com
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/homelab-agent
EnvironmentFile=/opt/homelab-agent/secrets.env
ExecStart=/usr/bin/python3 /opt/homelab-agent/agent.py
User=homelab
Group=homelab
